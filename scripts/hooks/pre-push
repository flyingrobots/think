#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=scripts/hooks/lib/scrub-git-env.sh
source "$(dirname "${BASH_SOURCE[0]}")/lib/scrub-git-env.sh"
scrub_git_location_env

if [[ "${THINK_PRE_PUSH_FULL:-0}" == "1" ]]; then
  echo "pre-push: running full local suite..."
  npm run test:local
  exit 0
fi

echo "pre-push: running fast checks..."
npm run test:fast
echo "pre-push: set THINK_PRE_PUSH_FULL=1 to run npm run test:local before pushing."
